3. Canvas & Rendering Component (src/components/SlideCanvas.tsx)

This component renders the active slide at the native 1080 × 1350 resolution,
scaled cleanly using CSS transformations to fit any display without pixelation.

import React, { useRef, useState } from 'react';
import { Slide, CanvasElement } from '../types';

interface SlideCanvasProps {
  slide: Slide;
  selectedElementId: string | null;
  onSelectElement: (id: string | null) => void;
  onUpdateElement: (updated: CanvasElement) => void;
  scale: number;
  showSafeZone: boolean;
  brandName: string;
}

export const SlideCanvas: React.FC<SlideCanvasProps> = ({
  slide,
  selectedElementId,
  onSelectElement,
  onUpdateElement,
  scale,
  showSafeZone,
  brandName,
}) => {
  const canvasRef = useRef<HTMLDivElement>(null);
  const [dragState, setDragState] = useState<{
    id: string;
    startX: number;
    startY: number;
    elemX: number;
    elemY: number;
  } | null>(null);

  const handlePointerDown = (e: React.PointerEvent, elem: CanvasElement) => {
    e.stopPropagation();
    onSelectElement(elem.id);

    setDragState({
      id: elem.id,
      startX: e.clientX,
      startY: e.clientY,
      elemX: elem.x,
      elemY: elem.y,
    });

    (e.target as HTMLElement).setPointerCapture(e.pointerId);
  };

  const handlePointerMove = (e: React.PointerEvent) => {
    if (!dragState) return;

    const dx = (e.clientX - dragState.startX) / scale;
    const dy = (e.clientY - dragState.startY) / scale;

    const currentElem = slide.elements.find((el) => el.id === dragState.id);
    if (!currentElem) return;

    onUpdateElement({
      ...currentElem,
      x: Math.round(dragState.elemX + dx),
      y: Math.round(dragState.elemY + dy),
    });
  };

  const handlePointerUp = () => {
    setDragState(null);
  };

  const renderElement = (el: CanvasElement) => {
    const isSelected = el.id === selectedElementId;

    return (
      <div
        key={el.id}
        onPointerDown={(e) => handlePointerDown(e, el)}
        style={{
          position: 'absolute',
          left: `${el.x}px`,
          top: `${el.y}px`,
          width: `${el.width}px`,
          height: `${el.height}px`,
          cursor: dragState?.id === el.id ? 'grabbing' : 'grab',
          outline: isSelected ? '2px solid #38BDF8' : 'none',
          outlineOffset: '4px',
          userSelect: 'none',
        }}
      >
        {el.type === 'text' && (
          <div
            style={{
              width: '100%',
              height: '100%',
              fontSize: `${el.fontSize}px`,
              fontWeight: el.fontWeight,
              fontFamily: el.fontFamily,
              color: el.color,
              textAlign: el.textAlign,
              lineHeight: el.lineHeight || 1.3,
              letterSpacing: el.letterSpacing ? `${el.letterSpacing}px` : 'normal',
              whiteSpace: 'pre-wrap',
              display: 'flex',
              alignItems: 'center',
            }}
          >
            {el.content}
          </div>
        )}

        {el.type === 'badge' && (
          <div
            style={{
              width: '100%',
              height: '100%',
              backgroundColor: el.bgColor,
              color: el.textColor,
              border: `1px solid ${el.borderColor}`,
              borderRadius: '9999px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              fontWeight: 700,
              fontSize: `${el.fontSize}px`,
              letterSpacing: '1px',
              textTransform: 'uppercase',
            }}
          >
            {el.text}
          </div>
        )}

        {el.type === 'metric' && (
          <div
            style={{
              width: '100%',
              height: '100%',
              backgroundColor: el.bgColor,
              border: `1px solid ${el.borderColor}`,
              borderRadius: '16px',
              padding: '24px',
              boxSizing: 'border-box',
              display: 'flex',
              flexDirection: 'column',
              justifyContent: 'center',
            }}
          >
            <span
              style={{
                fontSize: '16px',
                fontWeight: 600,
                color: '#94A3B8',
                letterSpacing: '1px',
                textTransform: 'uppercase',
                fontFamily: 'Inter',
              }}
            >
              {el.label}
            </span>
            <span
              style={{
                fontSize: '44px',
                fontWeight: 800,
                color: el.accentColor,
                marginTop: '8px',
                fontFamily: 'JetBrains Mono',
              }}
            >
              {el.value}
            </span>
          </div>
        )}

        {el.type === 'code' && (
          <div
            style={{
              width: '100%',
              height: '100%',
              backgroundColor: el.theme === 'dark' ? '#161B22' : '#0F172A',
              border: '1px solid #30363D',
              borderRadius: '16px',
              overflow: 'hidden',
              display: 'flex',
              flexDirection: 'column',
              fontFamily: 'JetBrains Mono, monospace',
            }}
          >
            {el.windowControls && (
              <div
                style={{
                  height: '42px',
                  backgroundColor: 'rgba(255,255,255,0.03)',
                  borderBottom: '1px solid #30363D',
                  display: 'flex',
                  alignItems: 'center',
                  paddingLeft: '18px',
                  gap: '8px',
                }}
              >
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#EF4444' }} />
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#F59E0B' }} />
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#10B981' }} />
                <span
                  style={{
                    marginLeft: 'auto',
                    marginRight: '20px',
                    fontSize: '13px',
                    color: '#64748B',
                    fontWeight: 600,
                  }}
                >
                  {el.language}
                </span>
              </div>
            )}
            <pre
              style={{
                margin: 0,
                padding: '24px',
                fontSize: `${el.fontSize}px`,
                color: '#E6EDF3',
                lineHeight: 1.5,
                overflowX: 'auto',
                whiteSpace: 'pre',
              }}
            >
              <code>{el.code}</code>
            </pre>
          </div>
        )}

        {el.type === 'image' && (
          <div
            style={{
              width: '100%',
              height: '100%',
              borderRadius: `${el.borderRadius}px`,
              border: `${el.borderWidth}px solid ${el.borderColor}`,
              overflow: 'hidden',
              background: '#1F2937',
            }}
          >
            <img
              src={el.src}
              alt="Element Screenshot"
              style={{
                width: '100%',
                height: '100%',
                objectFit: el.objectFit,
                pointerEvents: 'none',
              }}
            />
          </div>
        )}
      </div>
    );
  };

  return (
    <div
      style={{
        width: `${1080 * scale}px`,
        height: `${1350 * scale}px`,
        position: 'relative',
        boxShadow: '0 25px 50px -12px rgba(0, 0, 0, 0.25)',
        backgroundColor: '#FFFFFF',
      }}
      onPointerMove={handlePointerMove}
      onPointerUp={handlePointerUp}
      onClick={() => onSelectElement(null)}
    >
      <div
        ref={canvasRef}
        id="carousel-canvas"
        style={{
          width: '1080px',
          height: '1350px',
          position: 'absolute',
          top: 0,
          left: 0,
          transform: `scale(${scale})`,
          transformOrigin: 'top left',
          backgroundColor: slide.background,
          overflow: 'hidden',
        }}
      >
        {/* Optional 80px LinkedIn Safe Zone Grid Line */}
        {showSafeZone && (
          <div
            style={{
              position: 'absolute',
              top: '80px',
              left: '80px',
              width: '920px',
              height: '1190px',
              border: '1px dashed rgba(255, 255, 255, 0.15)',
              pointerEvents: 'none',
              zIndex: 9999,
            }}
          >
            <span
              style={{
                position: 'absolute',
                top: 4,
                left: 6,
                fontSize: '12px',
                color: 'rgba(255,255,255,0.4)',
                fontFamily: 'monospace',
              }}
            >
              80px Safe Margin
            </span>
          </div>
        )}

        {slide.elements.map(renderElement)}
      </div>
    </div>
  );
};

