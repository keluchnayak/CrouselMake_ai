1. Types & Data Structures (src/types.ts)

export type ElementType = 'text' | 'badge' | 'code' | 'image' | 'metric';

export interface BaseElement {
  id: string;
  type: ElementType;
  x: number;
  y: number;
  width: number;
  height: number;
  opacity?: number;
  rotation?: number;
}

export interface TextElement extends BaseElement {
  type: 'text';
  content: string;
  fontSize: number;
  fontWeight: number | string;
  fontFamily: string;
  color: string;
  textAlign: 'left' | 'center' | 'right';
  letterSpacing?: number;
  lineHeight?: number;
  isMonospace?: boolean;
}

export interface BadgeElement extends BaseElement {
  type: 'badge';
  text: string;
  bgColor: string;
  textColor: string;
  borderColor: string;
  fontSize: number;
}

export interface CodeElement extends BaseElement {
  type: 'code';
  code: string;
  language: string;
  theme: 'dark' | 'midnight' | 'light';
  fontSize: number;
  highlightLine?: number;
  windowControls?: boolean;
}

export interface ImageElement extends BaseElement {
  type: 'image';
  src: string;
  borderRadius: number;
  borderColor: string;
  borderWidth: number;
  objectFit: 'cover' | 'contain';
}

export interface MetricElement extends BaseElement {
  type: 'metric';
  label: string;
  value: string;
  accentColor: string;
  bgColor: string;
  borderColor: string;
}

export type CanvasElement =
  | TextElement
  | BadgeElement
  | CodeElement
  | ImageElement
  | MetricElement;

export interface Slide {
  id: string;
  title: string;
  background: string;
  elements: CanvasElement[];
}

export interface CarouselProject {
  id: string;
  title: string;
  brandName: string;
  accentColor: string;
  slides: Slide[];
}

