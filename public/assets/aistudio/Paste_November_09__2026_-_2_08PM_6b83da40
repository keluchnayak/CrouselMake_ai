import React, { useState, useEffect } from 'react';
import { CarouselProject, CanvasElement } from './types';
import { TEMPLATES } from './templates';
import { SlideCanvas } from './components/SlideCanvas';
import { SidebarControls } from './components/SidebarControls';
import { SlideNavigator } from './components/SlideNavigator';
import { rasterizeCanvasToImage, exportCarouselToPDF } from './utils/exportEngine';
import { Download, FileText, LayoutTemplate, ShieldCheck } from 'lucide-react';

export const App: React.FC = () => {
  const [project, setProject] = useState<CarouselProject>(TEMPLATES.mlDeepDive);
  const [activeSlideIdx, setActiveSlideIdx] = useState<number>(0);
  const [selectedElemId, setSelectedElemId] = useState<string | null>(null);
  const [zoomScale, setZoomScale] = useState<number>(0.55);
  const [showSafeZone, setShowSafeZone] = useState<boolean>(true);

  // Auto-fit zoom on window resize
  useEffect(() => {
    const handleResize = () => {
      const h = window.innerHeight - 260;
      const calculated = Math.min(h / 1350, 0.65);
      setZoomScale(Math.max(calculated, 0.35));
    };
    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  const currentSlide = project.slides[activeSlideIdx] || project.slides[0];
  const selectedElement = currentSlide.elements.find((el) => el.id === selectedElemId) || null;

  // Element CRUD Operations
  const handleUpdateElement = (updated: CanvasElement) => {
    setProject((prev) => {
      const slides = [...prev.slides];
      const elements = slides[activeSlideIdx].elements.map((el) =>
        el.id === updated.id ? updated : el
      );
      slides[activeSlideIdx] = { ...slides[activeSlideIdx], elements };
      return { ...prev, slides };
    });
  };

  const handleDeleteElement = (id: string) => {
    setProject((prev) => {
      const slides = [...prev.slides];
      slides[activeSlideIdx].elements = slides[activeSlideIdx].elements.filter((e) => e.id !== id);
      return { ...prev, slides };
    });
    setSelectedElemId(null);
  };

  const handleAddElement = (type: CanvasElement['type']) => {
    const newId = `elem-${Date.now()}`;
    let newElement: CanvasElement;

    if (type === 'text') {
      newElement = {
        id: newId,
        type: 'text',
        x: 100,
        y: 200,
        width: 600,
        height: 80,
        content: 'Edit this text content directly.',
        fontSize: 36,
        fontWeight: 600,
        fontFamily: 'Inter',
        color: '#FFFFFF',
        textAlign: 'left',
      };
    } else if (type === 'code') {
      newElement = {
        id: newId,
        type: 'code',
        x: 80,
        y: 300,
        width: 880,
        height: 400,
        code: `# Code With K\nSELECT user_id, count(*) \nFROM analytics_events \nGROUP BY 1;`,
        language: 'sql',
        theme: 'dark',
        fontSize: 22,
        windowControls: true,
      };
    } else if (type === 'metric') {
      newElement = {
        id: newId,
        type: 'metric',
        x: 80,
        y: 350,
        width: 420,
        height: 180,
        label: 'PERFORMANCE GAIN',
        value: '+82.4%',
        accentColor: project.accentColor,
        bgColor: '#161B22',
        borderColor: '#30363D',
      };
    } else {
      newElement = {
        id: newId,
        type: 'badge',
        x: 80,
        y: 80,
        width: 220,
        height: 44,
        text: 'KEY TAKEAWAYS',
        bgColor: '#161B22',
        textColor: project.accentColor,
        borderColor: '#30363D',
        fontSize: 16,
      };
    }

    setProject((prev) => {
      const slides = [...prev.slides];
      slides[activeSlideIdx].elements.push(newElement);
      return { ...prev, slides };
    });
    setSelectedElemId(newId);
  };

  // Slide CRUD Operations
  const handleAddSlide = () => {
    const newSlide = {
      id: `slide-${Date.now()}`,
      title: `Slide ${project.slides.length + 1}`,
      background: currentSlide.background,
      elements: [
        {
          id: `brand-${Date.now()}`,
          type: 'text' as const,
          x: 740,
          y: 85,
          width: 260,
          height: 40,
          content: project.brandName,
          fontSize: 24,
          fontWeight: 700,
          fontFamily: 'Inter',
          color: '#8B949E',
          textAlign: 'right' as const,
        },
      ],
    };
    setProject((prev) => ({ ...prev, slides: [...prev.slides, newSlide] }));
    setActiveSlideIdx(project.slides.length);
  };

  const handleDuplicateSlide = (index: number) => {
    const target = project.slides[index];
    const duplicated = {
      ...target,
      id: `slide-${Date.now()}`,
      title: `${target.title} (Copy)`,
      elements: target.elements.map((el) => ({ ...el, id: `el-${Date.now()}-${Math.random()}` })),
    };
    const updated = [...project.slides];
    updated.splice(index + 1, 0, duplicated);
    setProject((prev) => ({ ...prev, slides: updated }));
    setActiveSlideIdx(index + 1);
  };

  const handleDeleteSlide = (index: number) => {
    if (project.slides.length <= 1) return;
    const updated = project.slides.filter((_, idx) => idx !== index);
    setProject((prev) => ({ ...prev, slides: updated }));
    setActiveSlideIdx(Math.max(0, index - 1));
  };

  const handleMoveSlide = (from: number, to: number) => {
    const updated = [...project.slides];
    const [moved] = updated.splice(from, 1);
    updated.splice(to, 0, moved);
    setProject((prev) => ({ ...prev, slides: updated }));
    setActiveSlideIdx(to);
  };

  return (
    <div style={styles.appContainer}>
      {/* Top Header Bar */}
      <header style={styles.navbar}>
        <div style={styles.logoBadge}>
          <span style={styles.logoName}>{project.brandName}</span>
          <span style={styles.editorTag}>Studio</span>
        </div>

        {/* Preset Selector */}
        <div style={styles.templatePicker}>
          <LayoutTemplate size={16} color="#64748B" />
          <select
            style={styles.templateDropdown}
            onChange={(e) => {
              if (TEMPLATES[e.target.value]) {
                setProject(TEMPLATES[e.target.value]);
                setActiveSlideIdx(0);
                setSelectedElemId(null);
              }
            }}
          >
            <option value="mlDeepDive">Template: ML Focal Loss Deep Dive</option>
            <option value="sqlOptimization">Template: SQL Query Optimization</option>
          </select>
        </div>

        {/* Actions */}
        <div style={styles.navActions}>
          <button
            style={{
              ...styles.secondaryBtn,
              backgroundColor: showSafeZone ? '#F1F5F9' : '#FFFFFF',
            }}
            onClick={() => setShowSafeZone(!showSafeZone)}
            title="Toggle 80px Safe Margin Grid"
          >
            <ShieldCheck size={16} /> Margins
          </button>
          <button
            style={styles.secondaryBtn}
            onClick={() =>
              rasterizeCanvasToImage(
                'carousel-canvas',
                `${project.brandName}-Slide-${activeSlideIdx + 1}`
              )
            }
          >
            <Download size={16} /> Export Slide (PNG)
          </button>
          <button
            style={styles.primaryBtn}
            onClick={() => exportCarouselToPDF(project.slides, project.brandName)}
          >
            <FileText size={16} /> Export PDF Carousel
          </button>
        </div>
      </header>

      {/* Main Workspace Body */}
      <div style={styles.mainArea}>
        {/* Left Side: Property Controls */}
        <SidebarControls
          selectedElement={selectedElement}
          onUpdateElement={handleUpdateElement}
          onDeleteElement={handleDeleteElement}
          onAddElement={handleAddElement}
          slideBg={currentSlide.background}
          onUpdateSlideBg={(color) => {
            setProject((prev) => {
              const slides = [...prev.slides];
              slides[activeSlideIdx] = { ...slides[activeSlideIdx], background: color };
              return { ...prev, slides };
            });
          }}
        />

        {/* Center: Scaled Slide Canvas */}
        <main style={styles.canvasContainer}>
          <SlideCanvas
            slide={currentSlide}
            selectedElementId={selectedElemId}
            onSelectElement={setSelectedElemId}
            onUpdateElement={handleUpdateElement}
            scale={zoomScale}
            showSafeZone={showSafeZone}
            brandName={project.brandName}
          />
        </main>
      </div>

      {/* Bottom: Multi-Slide Manager */}
      <SlideNavigator
        slides={project.slides}
        activeSlideIndex={activeSlideIdx}
        onSelectSlide={(idx) => {
          setActiveSlideIdx(idx);
          setSelectedElemId(null);
        }}
        onAddSlide={handleAddSlide}
        onDuplicateSlide={handleDuplicateSlide}
        onDeleteSlide={handleDeleteSlide}
        onMoveSlide={handleMoveSlide}
      />
    </div>
  );
};

