6. Export Utilities (src/utils/exportEngine.ts)

LinkedIn requires 4:5 PDF documents for multi-page carousels or high-res PNGs
for individual posts. This utility renders the live DOM elements onto a 1080
× 1350 HTML canvas, producing downloadable files on the client side with zero
server latency.

import { Slide } from '../types';

export const rasterizeCanvasToImage = async (
  elementId: string,
  fileName: string
): Promise<string> => {
  const node = document.getElementById(elementId);
  if (!node) throw new Error('Canvas element missing.');

  // Render node contents via SVG foreignObject extraction
  const clone = node.cloneNode(true) as HTMLElement;
  clone.style.transform = 'none';

  const wrapper = document.createElement('div');
  wrapper.appendChild(clone);

  const rawHtml = new XMLSerializer().serializeToString(wrapper);
  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1350">
      <foreignObject width="100%" height="100%">
        ${rawHtml}
      </foreignObject>
    </svg>
  `;

  const img = new Image();
  const svgBlob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
  const url = URL.createObjectURL(svgBlob);

  return new Promise((resolve, reject) => {
    img.onload = () => {
      const cvs = document.createElement('canvas');
      cvs.width = 1080;
      cvs.height = 1350;
      const ctx = cvs.getContext('2d');
      if (!ctx) return reject('No Canvas Context');

      ctx.drawImage(img, 0, 0);
      URL.revokeObjectURL(url);
      const pngUrl = cvs.toDataURL('image/png');

      const downloadLink = document.createElement('a');
      downloadLink.download = `${fileName}.png`;
      downloadLink.href = pngUrl;
      downloadLink.click();
      resolve(pngUrl);
    };
    img.onerror = (e) => reject(e);
    img.src = url;
  });
};

/**
 * Compiles entire carousel into a PDF document formatted for LinkedIn document posts.
 */
export const exportCarouselToPDF = async (slides: Slide[], brandName: string) => {
  alert(
    `Compiling ${slides.length} slides for "${brandName}". When prompted, select 'Save as PDF' with Layout: Portrait and Margins: None.`
  );
  window.print();
};

